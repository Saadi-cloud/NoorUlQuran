# Public site URL used for canonical links, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where inquiry emails should be delivered
INQUIRY_TO_EMAIL=muhammadsaadm95@gmail.com

# Gmail SMTP (App Password from Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-secondary-email@gmail.com
SMTP_PASS=your-16-character-app-password
INQUIRY_FROM_EMAIL="Noor Ul Quran Online Academy <your-secondary-email@gmail.com>"

# Optional alternative: Resend API
RESEND_API_KEY=

# Recipient WhatsApp numbers for inquiry alerts (digits only, country code included)
WHATSAPP_NOTIFY_PHONE_MALE=923164021265
WHATSAPP_NOTIFY_PHONE_FEMALE=923227536446

# Official WhatsApp Cloud API (Meta) — recommended
# Guide: https://developers.facebook.com/documentation/business-messaging/whatsapp/overview/
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v22.0
# Create a template with 2 body variables: {{1}}=subject, {{2}}=details
WHATSAPP_CLOUD_TEMPLATE_NAME=new_inquiry_alert
WHATSAPP_CLOUD_TEMPLATE_LANG=en_US

# Optional fallback: CallMeBot (unofficial)
WHATSAPP_NOTIFY_APIKEY_MALE=
WHATSAPP_NOTIFY_APIKEY_FEMALE=
